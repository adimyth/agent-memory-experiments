# Copy to .env and fill in the key. The two model settings below are the values the
# committed results were produced with; changing them changes what you measure.
OPENAI_API_KEY=

# gpt-4o is pinned because it accepts temperature=0. Several newer models accept only
# their default temperature, which adds sampling variance on top of the variance the
# extraction prompts already have.
EXPERIMENT_LLM=gpt-4o

# Local embedder, downloaded once from HuggingFace. No embedding API access is needed.
EXPERIMENT_EMBEDDER=BAAI/bge-m3
EXPERIMENT_EMBED_DIMS=1024

# Optional overrides.
# AMX_FALKOR_PORT=6389                     # Graphiti's FalkorDB
# AMX_LETTA_URL=http://localhost:8283      # Letta server
# AMX_SHIM_URL=http://host.docker.internal:8399/v1   # embedding shim, as seen from Letta
# AMX_AWS_PROFILE=personal-agentcore       # AgentCore; see docs/agentcore-setup.md
# AMX_AWS_REGION=us-east-1
